# Database connection URL (PostgreSQL)
DB_URL="postgres://postgres:<password>@localhost:5432/chirpy?sslmode=disable"

# Application server port
PORT=8080

# Environment mode ("dev" enables admin reset endpoints)
PLATFORM="dev"

# JWT secret key for signing authentication tokens
SECRET="your-jwt-secret-key-here"

# Webhook API key for Polka payment upgrade events
POLKA_KEY="your-polka-api-key-here"
